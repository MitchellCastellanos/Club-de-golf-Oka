# Supabase (proyecto del Club de Golf d'Oka)
# Sin estas 3 variables, el sitio corre en modo demo: las reservas y
# solicitudes de boda no se persisten (se simula un codigo de confirmacion).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (correo transaccional)
# Sin estas 2 variables, el sitio corre en modo demo: no se envia ningun
# correo real. EMAIL_FROM debe ser una direccion de un dominio verificado
# en Resend, p.ej. "Golf d'Oka <reservations@demo.gabansolutions.ca>".
RESEND_API_KEY=
EMAIL_FROM=

# Pagos: se agregan en la Fase 2 una vez decidido el procesador
# (ver seccion 2 del plan ejecutivo: Stripe vs. Moneris/Helcim).
